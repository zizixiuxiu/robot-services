#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
PVC 自动分类 HTTP 服务（Docker / Linux 兼容）
端口：8005
接口：
  GET  /health
  POST /process
"""
import os
import sys
import base64
import shutil
import re
import zipfile
from pathlib import Path

WORK_DIR = Path(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, str(WORK_DIR))
# 公共库 factory-common（Docker 中通过 ENV PYTHONPATH=/app 提供）
sys.path.insert(0, str(WORK_DIR.parent.parent / "factory-common"))

from process_single import process_input
from factory_common.logging_utils import setup_logging
from factory_common.http_skeleton import run_process_server

# 输出根目录：默认在项目 data/output，Docker 中通过环境变量覆盖为 /app/data/output
OUTPUT_BASE = Path(os.getenv("OUTPUT_BASE", str(WORK_DIR.parent / "data" / "output")))

# ==================== 日志配置（公共库） ====================
logger = setup_logging("pvc-classify")
# ==================================================


def _resolve_dir_name(filename: str) -> str:
    """根据上传文件名推断输出目录名"""
    base = Path(filename).stem
    # 日期后带 W：6-14W平板 -> W6-14
    m = re.search(r"(\d+-\d+)[^\d-]*W", base, re.IGNORECASE)
    if m:
        return "W" + m.group(1)
    m = re.search(r"(\d+-\d+)", base)
    if m:
        return m.group(1)
    return base


def _safe_zip_name(name: str) -> str:
    return name.replace("/", "_").replace("\\", "_").strip() or "pvc-classify"


def _zip_output_files(file_paths: list[str], zip_path: Path, archive_prefix: str) -> Path:
    zip_path.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
        for file_path in file_paths:
            path = Path(file_path)
            if path.exists():
                zf.write(path, f"{archive_prefix}/{path.name}")
    return zip_path


def _encode_output_file(file_path: Path, filename: str = None) -> dict:
    """读取文件并返回 base64 编码结构（无 path 字段，保持原协议）"""
    try:
        with open(file_path, "rb") as fh:
            b64 = base64.b64encode(fh.read()).decode("utf-8")
        return {
            "filename": filename or file_path.name,
            "file_content": b64,
        }
    except Exception as e:
        logger.error("读取输出文件失败: %s, error=%s", file_path, e)
        return {
            "filename": filename or file_path.name,
            "error": f"读取文件内容失败: {e}",
        }


def process_pvc(input_path: str, output_dir: str, req: dict) -> dict:
    """骨架适配：单文件处理。自行打 zip 并经 output_files 返回（骨架跳过自动编码）。"""
    filename = req.get("filename", "input.xls")
    dir_name = req.get("dir_name")
    if not dir_name:
        dir_name = _resolve_dir_name(filename)

    logger.info("处理文件: %s -> dir_name=%s", filename, dir_name)
    work_dir = None
    try:
        result = process_input(
            input_path,
            dir_name=dir_name,
            output_base=str(OUTPUT_BASE),
            debug_output=False,
        )
        work_dir = Path(result["work_dir"])

        original_output_count = len(result["output_files"])
        zip_base = f"{_safe_zip_name(dir_name)}-自动分类"
        zip_path = work_dir / f"{zip_base}.zip"
        _zip_output_files(result["output_files"], zip_path, zip_base)
        encoded_files = [_encode_output_file(zip_path)]
        logger.info("转换完成: %s, 输出文件数=%d", filename, original_output_count)

        return {
            "success": True,
            "filename": filename,
            "dir_name": dir_name,
            "count": len(encoded_files),
            "zip_original_count": original_output_count,
            "quantity_total": result.get("quantity_total", 0),
            "quantity_files": result.get("quantity_files", []),
            "output_files": {filename: encoded_files},
        }
    except Exception as e:
        import traceback
        logger.exception("处理文件失败: %s", filename)
        return {
            "success": False,
            "error": f"服务异常: {str(e)}",
            "trace": traceback.format_exc(),
        }
    finally:
        if work_dir and work_dir.exists():
            shutil.rmtree(work_dir, ignore_errors=True)


def _batch_aggregate(response: dict, results: list, files: list) -> None:
    """批量响应聚合：补充网关数量卡片依赖的 quantity_total/quantity_files，
    并按原服务字段顺序重排响应（quantity_* 在 cost_seconds 之前，error 最后）。"""
    quantity_total = sum(
        float(res.get("quantity_total") or 0) for res in results if res.get("success")
    )
    quantity_files = []
    for res in results:
        if res.get("success"):
            quantity_files.extend(res.get("quantity_files") or [])

    reordered = {
        "success": response["success"],
        "batch": response["batch"],
        "count": response["count"],
        "results": response["results"],
        "output_files": response["output_files"],
        "quantity_total": int(quantity_total) if quantity_total.is_integer() else quantity_total,
        "quantity_files": quantity_files,
        "cost_seconds": response["cost_seconds"],
    }
    if "error" in response:
        reordered["error"] = response["error"]
    response.clear()
    response.update(reordered)


if __name__ == "__main__":
    run_process_server(
        service_name="pvc-classify",
        default_port=8005,
        process_fn=process_pvc,
        logger=logger,
        # 原服务批量为串行 for 循环，default_max_workers=1 保持并发行为一致
        max_workers_env="PVC_CLASSIFY_MAX_WORKERS",
        default_max_workers=1,
        default_output_base=WORK_DIR.parent / "data" / "output",
        missing_file_error="缺少 file_content",
        batch_error_aggregate=True,
        batch_aggregate_hook=_batch_aggregate,
    )
