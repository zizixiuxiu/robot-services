#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Dealer report HTTP service.

Port: 8008
API: POST /process（别名 /convert）
仅支持 {files:[...]} 多文件整体任务：账号指标 + 设计师数据统计合并生成单个报表。
"""
from __future__ import annotations

import base64
import os
import sys
import time
import traceback
from pathlib import Path

import pandas as pd

WORK_DIR = Path(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, str(WORK_DIR))
# 公共库 factory-common（Docker 中通过 ENV PYTHONPATH=/app 提供）
sys.path.insert(0, str(WORK_DIR.parent.parent / "factory-common"))

from factory_common.logging_utils import setup_logging  # noqa: E402
from factory_common.http_skeleton import run_process_server, _encode_output_file  # noqa: E402

from generate_dealer_report import (  # noqa: E402
    DEFAULT_REGION_ORDER,
    build_output_df,
    process_account_data,
    process_designer_data,
    write_formatted_excel_new,
)


OUTPUT_DIR = Path(os.getenv("OUTPUT_DIR", str(WORK_DIR.parent / "data" / "output")))
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

logger = setup_logging("dealer-report")

MISSING_FILES_ERROR = "需要上传 files 数组，包含账号指标和设计师数据统计文件"


class _ProtocolDict(dict):
    """骨架会对 multi_file_fn/process_fn 返回的 dict 自动补写 cost_seconds。

    本服务错误响应协议不含 cost_seconds 字段：拦截 __setitem__/__contains__
    让骨架以为该字段已存在而跳过写入，实际并不存储，json.dumps 输出与旧 Handler
    逐字节一致（dict 子类不影响 json 编码）。
    成功响应的 cost_seconds 在构造字面量时直接写入，不受影响。
    """

    def __setitem__(self, key, value):
        if key == "cost_seconds":
            return
        super().__setitem__(key, value)

    def __contains__(self, key):
        if key == "cost_seconds":
            return True
        return super().__contains__(key)


def _detect_file_type(filename: str) -> str:
    name = filename or ""
    if "账号指标" in name or "账号信息" in name:
        return "account"
    if "设计师数据统计" in name or "设计师" in name:
        return "designer"
    return "unknown"


def _safe_stem(filename: str) -> str:
    stem = Path(filename or "dealer-report").stem.strip()
    return stem.strip(" -_") or "dealer-report"


def _decode_to_file(content_b64: str, path: Path) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(base64.b64decode(content_b64))
    return path


def _combine_account_data(account_paths: list[Path]) -> pd.DataFrame:
    frames = [process_account_data(path) for path in account_paths]
    combined = pd.concat(frames, ignore_index=True)
    agg = combined.groupby(["区域", "经销商"], as_index=False).agg({
        "创建方案数": "sum",
        "新增渲染方案数": "sum",
    })
    agg["区域_order"] = agg["区域"].apply(
        lambda x: DEFAULT_REGION_ORDER.index(x) if x in DEFAULT_REGION_ORDER else 999
    )
    return agg.sort_values(["区域_order", "经销商"]).drop(columns="区域_order").reset_index(drop=True)


def _combine_designer_data(designer_paths: list[Path]) -> pd.DataFrame:
    frames = [process_designer_data(path) for path in designer_paths]
    combined = pd.concat(frames, ignore_index=True)
    return combined.groupby("经销商", as_index=False).agg({"提审方案数": "sum"})


def run_dealer_report(account_paths: list[Path], designer_paths: list[Path], output_path: Path, title: str) -> dict:
    account_agg = _combine_account_data(account_paths)
    designer_agg = _combine_designer_data(designer_paths)
    out_df = build_output_df(account_agg, designer_agg)
    write_formatted_excel_new(out_df, output_path, title=title)
    return {
        "rows": int(len(out_df)),
        "account_rows": int(len(account_agg)),
        "designer_rows": int(len(designer_agg)),
        "account_files": len(account_paths),
        "designer_files": len(designer_paths),
    }


def _process_files(req: dict, work_dir: str) -> dict:
    """multi_file_fn：{files:[...]} 整体一个任务，多文件合并单输出（协议与旧 Handler 一致）"""
    files = req.get("files")
    tmpdir = Path(work_dir)
    try:
        file_map: dict[str, list[Path]] = {"account": [], "designer": []}
        first_filename = ""
        for item in files:
            content = item.get("file_content")
            filename = item.get("filename", "input.xlsx")
            if not first_filename:
                first_filename = filename
            if not content:
                continue
            path = _decode_to_file(content, tmpdir / filename)
            file_type = _detect_file_type(filename)
            if file_type != "unknown":
                file_map[file_type].append(path)

        missing = [name for name in ("account", "designer") if not file_map[name]]
        if missing:
            return _ProtocolDict({
                "success": False,
                "error": f"缺少必要文件: {missing}。文件名需包含：账号指标、设计师数据统计",
            })

        title = req.get("title") or "经销商数据"
        output_name = req.get("output_filename") or f"{_safe_stem(first_filename)}_经销商数据.xlsx"
        output_dir = OUTPUT_DIR / f"output_http_{int(time.time())}"
        output_dir.mkdir(parents=True, exist_ok=True)
        output_path = output_dir / output_name

        t0 = time.time()
        stats = run_dealer_report(file_map["account"], file_map["designer"], output_path, title)
        cost = round(time.time() - t0, 3)
        if not output_path.exists():
            return _ProtocolDict({"success": False, "error": "输出文件未生成"})

        logger.info("Dealer report generated: %s, cost=%.3fs", output_path, cost)
        return {
            "success": True,
            "service": "dealer-report",
            "output_dir": str(output_dir),
            "output_filename": output_name,
            "output_files": [_encode_output_file(output_path, logger, output_name)],
            "stats": stats,
            "cost_seconds": cost,
        }
    except Exception as exc:
        logger.exception("Failed to process dealer report")
        return _ProtocolDict({
            "success": False,
            "error": f"服务异常: {exc}",
            "trace": traceback.format_exc(),
        })


def _process_single_adapter(input_path: str, output_dir: str, req: dict) -> dict:
    """本服务只有批量模式；单文件请求按旧协议返回错误（骨架补写的 cost_seconds 被 _ProtocolDict 拦截）"""
    return _ProtocolDict({"success": False, "error": MISSING_FILES_ERROR})


if __name__ == "__main__":
    run_process_server(
        service_name="dealer-report",
        default_port=8008,
        process_fn=_process_single_adapter,
        multi_file_fn=_process_files,
        logger=logger,
        max_workers_env="DEALER_REPORT_MAX_WORKERS",
        default_output_base=WORK_DIR.parent / "data" / "output",
        path_aliases=("/convert",),
        missing_file_error=MISSING_FILES_ERROR,
        # GET 保持骨架默认：任何 GET 返回 ok
    )
