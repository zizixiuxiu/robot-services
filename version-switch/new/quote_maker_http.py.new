#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Quote maker HTTP service.

Port: 8007
API: POST /process
"""
import base64
import os
import re
import shutil
import sys
import tempfile
import time
from pathlib import Path

WORK_DIR = Path(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, str(WORK_DIR))
# 公共库 factory-common（Docker 中通过 ENV PYTHONPATH=/app 提供）
sys.path.insert(0, str(WORK_DIR.parent.parent / "factory-common"))

from factory_common.logging_utils import setup_logging  # noqa: E402
from factory_common.http_skeleton import run_process_server, _encode_output_file  # noqa: E402

DEFAULT_TEMPLATE = Path(os.getenv("QUOTE_TEMPLATE", str(WORK_DIR / "templates" / "quote_template.xlsx")))

from make_quote import (  # noqa: E402
    apply_quote_page_background,
    base_order_no,
    build_workbook_input_only,
    copy_formulas_from_reference,
    decide_group_mode,
    parse_quote_input,
    postprocess_hardware_from_input,
    sync_output_path_order_no,
)


logger = setup_logging("quote-maker")


def _safe_stem(filename: str) -> str:
    stem = Path(filename or "input.xls").stem.strip()
    stem = stem.replace("空订单号", "").strip(" -_")
    suffixes = ("拆单报价", "报价料单", "报价单", "料单", "报价")
    changed = True
    while changed:
        changed = False
        for suffix in suffixes:
            if stem.endswith(suffix):
                stem = stem[: -len(suffix)].strip(" -_")
                changed = True
                break
    stem = stem.strip(" -_")
    return stem or "quote"


def _stem_for_order(base: str, order_no: str | None) -> str:
    if not order_no:
        return base
    match = re.match(r"^(S\d{4}-[\d-]+)(.*)$", base, re.IGNORECASE)
    if match:
        suffix = match.group(2)
        # Drop secondary order numbers like " 6007" from the suffix, keep customer name.
        suffix = re.sub(r"^\s*\d{4}\s*", "", suffix).strip(" -_")
        if suffix:
            return f"{order_no} {suffix}"
        return order_no
    if base.startswith(order_no):
        return base
    return f"{order_no} {base}".strip(" -_")


def _quote_output_name(base: str, order_no: str | None = None) -> str:
    stem = _stem_for_order(base, order_no)
    return f"{stem}报价单.xlsx"


def _decode_to_file(content_b64: str, path: Path) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "wb") as fh:
        fh.write(base64.b64decode(content_b64))
    return path


def _resolve_template(req: dict, tmpdir: Path) -> Path:
    template_content = req.get("template_content") or req.get("template_file_content")
    if template_content:
        template_name = req.get("template_filename", "quote_template.xlsx")
        return _decode_to_file(template_content, tmpdir / template_name)
    if not DEFAULT_TEMPLATE.exists():
        raise FileNotFoundError(f"默认报价模板不存在: {DEFAULT_TEMPLATE}")
    return DEFAULT_TEMPLATE


def _resolve_reference(req: dict, tmpdir: Path) -> Path | None:
    reference_content = req.get("reference_content") or req.get("reference_file_content")
    if not reference_content:
        return None
    reference_name = req.get("reference_filename", "reference.xlsx")
    return _decode_to_file(reference_content, tmpdir / reference_name)


def process_quote(input_path: str, output_dir: str, req: dict) -> dict:
    """骨架 process_fn：input_path 已由骨架解码落盘，output_dir 已由骨架创建。"""
    filename = req.get("filename", "input.xls")
    input_path = Path(input_path)
    output_dir = Path(output_dir)

    tmpdir = Path(tempfile.mkdtemp(prefix="quote_maker_"))
    try:
        template_path = _resolve_template(req, tmpdir)
        reference_path = _resolve_reference(req, tmpdir)

        base = _safe_stem(filename)

        output_entries = []
        t0 = time.time()
        if req.get("match_reference") and reference_path and reference_path.exists():
            output_name = req.get("output_filename") or _quote_output_name(base)
            output_path = output_dir / output_name
            shutil.copyfile(reference_path, output_path)
            apply_quote_page_background(output_path)
            output_entries.append(_encode_output_file(output_path, logger, filename=output_name))
        else:
            parsed = parse_quote_input(input_path)
            source_items = parsed.items
            source_hardware_items = parsed.hardware_items
            source_header = parsed.header
            orders = parsed.orders or [None]
            warnings = list(parsed.warnings)
            requested_mode = req.get("group_mode", "auto")
            resolved_mode, mode_note = decide_group_mode(source_items, requested_mode)
            if mode_note:
                warnings.append(mode_note)

            if resolved_mode == "color":
                # 按颜色分表时，同一基础单号（如 S2607-6047）输出一个文件；
                # 文件内部按设计师区分的 -1/-2/-3 子订单生成多个 sheet。
                base_orders: dict[str, list[str]] = {}
                for order_no in orders:
                    if order_no is None:
                        continue
                    b = base_order_no(order_no)
                    base_orders.setdefault(b, []).append(order_no)
                if not base_orders:
                    base_orders = {"": [None]}
                for base_order, sub_orders in base_orders.items():
                    output_name = req.get("output_filename") if len(base_orders) == 1 else None
                    output_name = output_name or _quote_output_name(base, base_order or None)
                    output_path = output_dir / output_name
                    filtered_items = [
                        item for item in source_items
                        if item.order_no is None or base_order_no(item.order_no) == base_order
                    ]
                    filtered_hardware = [
                        item for item in source_hardware_items
                        if item.order_no is None or base_order_no(item.order_no) == base_order
                    ]
                    header = dict(source_header)
                    if base_order:
                        header["order_no"] = base_order
                    build_workbook_input_only(
                        input_path,
                        template_path,
                        output_path,
                        order_no=None,
                        group_mode="color",
                        source_items=filtered_items,
                        source_hardware_items=filtered_hardware,
                        source_header=header,
                    )
                    if reference_path and reference_path.exists():
                        copy_formulas_from_reference(output_path, reference_path)
                        postprocess_hardware_from_input(
                            output_path,
                            input_path,
                            order_no=None,
                            hardware_items=filtered_hardware,
                        )
                    output_entries.append(_encode_output_file(output_path, logger, filename=output_name))
            else:
                # 按区域分表时，保持原来的按完整订单编号分文件
                for order_no in orders:
                    output_name = req.get("output_filename") if len(orders) == 1 else None
                    output_name = output_name or _quote_output_name(base, order_no)
                    if len(orders) == 1:
                        output_path = sync_output_path_order_no(input_path, output_dir / output_name)
                    else:
                        output_path = output_dir / output_name
                    output_name = output_path.name
                    build_workbook_input_only(
                        input_path,
                        template_path,
                        output_path,
                        order_no=order_no,
                        group_mode="area",
                        source_items=source_items,
                        source_hardware_items=source_hardware_items,
                        source_header=source_header,
                    )
                    if reference_path and reference_path.exists():
                        copy_formulas_from_reference(output_path, reference_path)
                        postprocess_hardware_from_input(
                            output_path,
                            input_path,
                            order_no=order_no,
                            hardware_items=source_hardware_items,
                        )
                    output_entries.append(_encode_output_file(output_path, logger, filename=output_name))

        cost = round(time.time() - t0, 3)
        if not output_entries:
            return {"success": False, "error": "输出文件未生成"}

        pair_key = Path(filename).name
        logger.info("Quote generated: %s -> %d file(s), cost=%.3fs", filename, len(output_entries), cost)
        return {
            "success": True,
            "service": "quote-maker",
            "output_dir": str(output_dir),
            "output_filename": output_entries[0].get("filename") if len(output_entries) == 1 else None,
            "output_files": {
                pair_key: output_entries,
            },
            "warnings": warnings if not req.get("match_reference") else [],
            "cost_seconds": cost,
        }
    except Exception as exc:
        import traceback

        logger.exception("Failed to process quote file: %s", filename)
        return {"success": False, "error": f"服务异常: {exc}", "trace": traceback.format_exc()}
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


if __name__ == "__main__":
    run_process_server(
        service_name="quote-maker",
        default_port=8007,
        process_fn=process_quote,
        logger=logger,
        max_workers_env="QUOTE_MAX_WORKERS",
        default_max_workers=1,
        default_output_base=WORK_DIR.parent / "data" / "output",
        path_aliases=("/convert",),
        missing_file_error="缺少 file_content",
        get_paths=("/", "/health"),
    )
