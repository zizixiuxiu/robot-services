#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CSV 板件转换 HTTP 服务（Docker / Linux 兼容）
端口：8004
接口：
  GET  /health
  POST /process
"""

import os
import sys
import time
from pathlib import Path

WORK_DIR = Path(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, str(WORK_DIR))
# 公共库 factory-common（Docker 中通过 ENV PYTHONPATH=/app 提供）
sys.path.insert(0, str(WORK_DIR.parent.parent / "factory-common"))

from convert_board_csv import convert_csv
from factory_common.logging_utils import setup_logging
from factory_common.http_skeleton import run_process_server

logger = setup_logging("csv-board")


def _process_csv_board(input_path: str, output_dir: str, filename: str) -> dict:
    """处理单个 CSV 板件转换"""
    base = Path(filename).stem
    output_path = Path(output_dir) / f"{base}_模板.csv"

    logger.info("处理文件: %s -> %s", filename, output_path)
    t0 = time.time()
    try:
        result = convert_csv(input_path, str(output_path))
    except Exception as e:
        import traceback
        logger.exception("处理文件失败: %s", filename)
        return {
            "success": False,
            "error": f"服务异常: {str(e)}",
            "trace": traceback.format_exc(),
        }
    cost = round(time.time() - t0, 3)
    logger.info("转换完成: %s, rows=%d, cost=%.3fs", filename, result["rows"], cost)

    return {
        "success": True,
        "filename": filename,
        "count": 1,
        "files": [output_path.name],
    }


def _process_adapter(input_path: str, output_dir: str, req: dict) -> dict:
    """骨架适配：骨架已把 base64 落盘为与 filename 同名的临时文件"""
    return _process_csv_board(input_path, output_dir, Path(input_path).name)


if __name__ == "__main__":
    run_process_server(
        service_name="csv-board",
        default_port=8004,
        process_fn=_process_adapter,
        logger=logger,
        # 原服务批量为串行 for 循环，default_max_workers=1 保持并发行为一致
        max_workers_env="CSV_BOARD_MAX_WORKERS",
        default_max_workers=1,
        encode_workers_env="CSV_BOARD_ENCODE_MAX_WORKERS",
        default_output_base=WORK_DIR.parent / "data" / "output",
    )
